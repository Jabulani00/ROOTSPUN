# ─── Supabase ────────────────────────────────────────────────────────────────
# Public (safe for the browser — RLS protects every query)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server / worker only — NEVER ship to the browser (NFR-01)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI engines (worker) ───────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=            # phase 4

# ─── SERP provider (licensed — NFR-10) ──────────────────────────────────────────
SERP_PROVIDER=dataforseo      # dataforseo | serpapi
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_KEY=

# ─── Google data ─────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PSI_API_KEY=
GOOGLE_CRUX_API_KEY=

# ─── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Billing (phase 4) ──────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Observability ──────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
